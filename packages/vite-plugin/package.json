{
  "name": "@nmbl-lang/vite-plugin",
  "version": "0.1.0",
  "description": "Vite plugin for .nmbl files and <template lang=\"nmbl\"> in Vue SFCs",
  "keywords": [
    "nmbl",
    "template",
    "vite",
    "vite-plugin"
  ],
  "license": "MIT",
  "author": "Theo Ephraim",
  "homepage": "https://nmbl.tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theoephraim/nmbl.git",
    "directory": "packages/vite-plugin"
  },
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./tag": {
      "import": "./dist/tag.mjs",
      "types": "./dist/tag.d.mts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "tbuild": "turbo run build",
    "dev": "bun run build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nmbl-lang/core": "workspace:*",
    "magic-string": "^0.30.21",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "vite": ">=5.0.0",
    "vue": ">=3.0.0"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}
