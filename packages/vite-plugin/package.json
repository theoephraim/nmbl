{
  "name": "@nmbl/vite-plugin",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./tag": {
      "import": "./dist/tag.mjs",
      "types": "./dist/tag.d.mts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "tbuild": "turbo run build",
    "dev": "bun run build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nmbl/parser": "workspace:*",
    "magic-string": "^0.30.21"
  },
  "peerDependencies": {
    "vite": ">=5.0.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
