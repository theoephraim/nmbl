{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2020"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["extension.ts", "embedded-forwarding.ts", "convert.ts"],
  "exclude": ["node_modules"]
}
