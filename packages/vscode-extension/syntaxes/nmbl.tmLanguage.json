{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "nmbl",
  "scopeName": "source.nmbl",
  "patterns": [
    {
      "include": "#nmbl-frontmatter"
    },
    {
      "include": "#nmbl-script-block"
    },
    {
      "include": "#nmbl-style-block"
    },
    {
      "include": "#nmbl-markdown-block"
    },
    {
      "include": "#nmbl-generic-raw-block"
    },
    {
      "include": "#renderedblockcomment"
    },
    {
      "include": "#renderedcomment"
    },
    {
      "include": "#silentcomment"
    },
    {
      "include": "#blockcomment"
    },
    {
      "include": "#taghead"
    },
    {
      "include": "#dqstring"
    },
    {
      "include": "#sqstring"
    },
    {
      "include": "#atkeyword"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#indent"
    },
    {
      "include": "#dedent"
    },
    {
      "include": "#newline"
    },
    {
      "include": "#rawcontent"
    },
    {
      "include": "#textchunk"
    }
  ],
  "repository": {
    "indent": {
      "name": "variable.other.nmbl",
      "match": "(?!)"
    },
    "dedent": {
      "name": "variable.other.nmbl",
      "match": "(?!)"
    },
    "newline": {
      "name": "variable.other.nmbl",
      "match": "(?!)"
    },
    "rawcontent": {
      "name": "source.embedded.nmbl",
      "match": "(?!)"
    },
    "idsel": {
      "name": "entity.other.attribute-name.id.nmbl",
      "match": "#[a-zA-Z0-9\\-_]+"
    },
    "classsel": {
      "name": "entity.other.attribute-name.class.nmbl",
      "match": "\\.[a-zA-Z0-9\\-_]+"
    },
    "atkeyword": {
      "name": "keyword.control.nmbl",
      "match": "@[a-zA-Z]+"
    },
    "componentname": {
      "name": "support.class.component.readwrite.nmbl",
      "match": "[A-Z][a-zA-Z0-9\\-_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*"
    },
    "tagname": {
      "name": "entity.name.tag.nmbl",
      "match": "[a-z][a-zA-Z0-9\\-_]*"
    },
    "renderedblockcomment": {
      "name": "comment.block.rendered.nmbl",
      "begin": "/\\*!",
      "end": "\\*/"
    },
    "renderedcomment": {
      "name": "comment.line.double-slash.rendered.nmbl",
      "match": "//![^\\n]*"
    },
    "silentcomment": {
      "name": "comment.line.double-slash.nmbl",
      "match": "//[^\\n]*"
    },
    "blockcomment": {
      "name": "comment.block.nmbl",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "textchunk": {
      "name": "text.nmbl",
      "match": "[^ \\t\\n\\r()>|]+"
    },
    "attrname": {
      "name": "entity.other.attribute-name.nmbl",
      "match": "[a-zA-Z@:#][a-zA-Z0-9\\-_.:@]*"
    },
    "dqstring": {
      "name": "string.quoted.double.nmbl",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.nmbl"
        }
      },
      "end": "\"|$",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.nmbl"
        }
      },
      "patterns": [
        {
          "match": "\\\\[\\s\\S]",
          "name": "constant.character.escape.nmbl"
        }
      ]
    },
    "sqstring": {
      "name": "string.quoted.single.nmbl",
      "begin": "'",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.nmbl"
        }
      },
      "end": "'|$",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.nmbl"
        }
      },
      "patterns": [
        {
          "match": "\\\\[\\s\\S]",
          "name": "constant.character.escape.nmbl"
        }
      ]
    },
    "template": {
      "name": "string.template.nmbl",
      "match": "`(?:[^`\\\\$]|\\\\[`\\\\$]|\\$(?!\\{))*`"
    },
    "barevalue": {
      "name": "string.unquoted.nmbl",
      "match": "[^ \\t\\n\\r(){}\"'`=>|,]+"
    },
    "punctuation": {
      "match": "=|>|\\||,|\\(|\\)|\\{|\\}",
      "name": "punctuation.nmbl"
    },
    "attrlist": {
      "begin": "\\(",
      "beginCaptures": {
        "0": {
          "name": "punctuation.nmbl"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.nmbl"
        }
      },
      "patterns": [
        {
          "include": "#renderedblockcomment"
        },
        {
          "include": "#renderedcomment"
        },
        {
          "include": "#silentcomment"
        },
        {
          "include": "#blockcomment"
        },
        {
          "include": "#attrname"
        },
        {
          "include": "#dqstring"
        },
        {
          "include": "#sqstring"
        },
        {
          "include": "#template"
        },
        {
          "include": "#barevalue"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "taghead": {
      "begin": "(?:^[ \\t]*|(?<=>)[ \\t]*)(?=(?:[a-z][a-zA-Z0-9\\-_]*|[A-Z][a-zA-Z0-9\\-_]*|#[a-zA-Z0-9\\-_]+|\\.[a-zA-Z0-9\\-_]+|#[a-zA-Z0-9\\-_]+|\\.[a-zA-Z0-9\\-_]+))",
      "end": "(?=[ \\t]|$)",
      "patterns": [
        {
          "include": "#tagname"
        },
        {
          "include": "#componentname"
        },
        {
          "include": "#idsel"
        },
        {
          "include": "#classsel"
        },
        {
          "include": "#idsel"
        },
        {
          "include": "#classsel"
        },
        {
          "include": "#attrlist"
        }
      ]
    },
    "nmbl-frontmatter": {
      "comment": "YAML frontmatter delimited by --- at the very top of a .nmbl file",
      "begin": "\\A(---)[ \\t]*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.frontmatter.begin.nmbl"
        }
      },
      "end": "^(---)[ \\t]*$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.frontmatter.end.nmbl"
        }
      },
      "contentName": "meta.embedded.block.frontmatter.yaml source.yaml",
      "patterns": [
        {
          "include": "source.yaml"
        }
      ]
    },
    "nmbl-script-block": {
      "comment": "NMBL script: content block — body embeds JavaScript",
      "begin": "^(\\s*)(script(?:\\([^)]*\\))*)((:))\\s*$",
      "beginCaptures": {
        "2": {
          "patterns": [
            {
              "include": "#componentname"
            },
            {
              "include": "#tagname"
            },
            {
              "include": "#attrname"
            },
            {
              "include": "#punctuation"
            }
          ]
        },
        "3": {
          "name": "storage.type.content-mode.nmbl"
        }
      },
      "while": "^(?=\\1[ \\t]|[ \\t]*$)",
      "contentName": "meta.embedded.block.javascript source.js",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "nmbl-style-block": {
      "comment": "NMBL style: content block — body embeds CSS",
      "begin": "^(\\s*)(style(?:\\([^)]*\\))*)((:))\\s*$",
      "beginCaptures": {
        "2": {
          "patterns": [
            {
              "include": "#componentname"
            },
            {
              "include": "#tagname"
            },
            {
              "include": "#attrname"
            },
            {
              "include": "#punctuation"
            }
          ]
        },
        "3": {
          "name": "storage.type.content-mode.nmbl"
        }
      },
      "while": "^(?=\\1[ \\t]|[ \\t]*$)",
      "contentName": "meta.embedded.block.css source.css",
      "patterns": [
        {
          "include": "source.css"
        }
      ]
    },
    "nmbl-markdown-block": {
      "comment": "NMBL :md content block — body embeds Markdown (any tag:md or bare :md)",
      "begin": "^(\\s*)([^\\s]*)((:)md)\\s*$",
      "beginCaptures": {
        "2": {
          "patterns": [
            {
              "include": "#componentname"
            },
            {
              "include": "#tagname"
            },
            {
              "include": "#attrname"
            },
            {
              "include": "#punctuation"
            }
          ]
        },
        "3": {
          "name": "storage.type.content-mode.nmbl"
        }
      },
      "while": "^(?=\\1[ \\t]|[ \\t]*$)",
      "contentName": "meta.embedded.block.markdown text.html.markdown",
      "patterns": [
        {
          "begin": "^\\s*(`{3,}|~{3,})[ \\t]*(js|javascript|mjs|cjs)\\b.*$",
          "end": "^\\s*\\1[ \\t]*$",
          "name": "markup.fenced_code.block.markdown",
          "beginCaptures": {
            "2": {
              "name": "fenced_code.block.language.markdown"
            }
          },
          "contentName": "meta.embedded.block.javascript source.js",
          "patterns": [
            {
              "include": "source.js"
            }
          ]
        },
        {
          "begin": "^\\s*(`{3,}|~{3,})[ \\t]*(ts|typescript|mts|cts)\\b.*$",
          "end": "^\\s*\\1[ \\t]*$",
          "name": "markup.fenced_code.block.markdown",
          "beginCaptures": {
            "2": {
              "name": "fenced_code.block.language.markdown"
            }
          },
          "contentName": "meta.embedded.block.typescript source.ts",
          "patterns": [
            {
              "include": "source.ts"
            }
          ]
        },
        {
          "begin": "^\\s*(`{3,}|~{3,})[ \\t]*(jsx)\\b.*$",
          "end": "^\\s*\\1[ \\t]*$",
          "name": "markup.fenced_code.block.markdown",
          "beginCaptures": {
            "2": {
              "name": "fenced_code.block.language.markdown"
            }
          },
          "contentName": "meta.embedded.block.javascriptreact source.js.jsx",
          "patterns": [
            {
              "include": "source.js.jsx"
            }
          ]
        },
        {
          "begin": "^\\s*(`{3,}|~{3,})[ \\t]*(tsx)\\b.*$",
          "end": "^\\s*\\1[ \\t]*$",
          "name": "markup.fenced_code.block.markdown",
          "beginCaptures": {
            "2": {
              "name": "fenced_code.block.language.markdown"
            }
          },
          "contentName": "meta.embedded.block.typescriptreact source.tsx",
          "patterns": [
            {
              "include": "source.tsx"
            }
          ]
        },
        {
          "begin": "^\\s*(`{3,}|~{3,})[ \\t]*(json|jsonc|json5)\\b.*$",
          "end": "^\\s*\\1[ \\t]*$",
          "name": "markup.fenced_code.block.markdown",
          "beginCaptures": {
            "2": {
              "name": "fenced_code.block.language.markdown"
            }
          },
          "contentName": "meta.embedded.block.json source.json",
          "patterns": [
            {
              "include": "source.json"
            }
          ]
        },
        {
          "begin": "^\\s*(`{3,}|~{3,})[ \\t]*(html)\\b.*$",
          "end": "^\\s*\\1[ \\t]*$",
          "name": "markup.fenced_code.block.markdown",
          "beginCaptures": {
            "2": {
              "name": "fenced_code.block.language.markdown"
            }
          },
          "contentName": "meta.embedded.block.html text.html.basic",
          "patterns": [
            {
              "include": "text.html.basic"
            }
          ]
        },
        {
          "begin": "^\\s*(`{3,}|~{3,})[ \\t]*(css)\\b.*$",
          "end": "^\\s*\\1[ \\t]*$",
          "name": "markup.fenced_code.block.markdown",
          "beginCaptures": {
            "2": {
              "name": "fenced_code.block.language.markdown"
            }
          },
          "contentName": "meta.embedded.block.css source.css",
          "patterns": [
            {
              "include": "source.css"
            }
          ]
        },
        {
          "begin": "^\\s*(`{3,}|~{3,})[ \\t]*(scss)\\b.*$",
          "end": "^\\s*\\1[ \\t]*$",
          "name": "markup.fenced_code.block.markdown",
          "beginCaptures": {
            "2": {
              "name": "fenced_code.block.language.markdown"
            }
          },
          "contentName": "meta.embedded.block.scss source.css.scss",
          "patterns": [
            {
              "include": "source.css.scss"
            }
          ]
        },
        {
          "begin": "^\\s*(`{3,}|~{3,})[ \\t]*(sh|bash|shell|zsh|console)\\b.*$",
          "end": "^\\s*\\1[ \\t]*$",
          "name": "markup.fenced_code.block.markdown",
          "beginCaptures": {
            "2": {
              "name": "fenced_code.block.language.markdown"
            }
          },
          "contentName": "meta.embedded.block.shellscript source.shell",
          "patterns": [
            {
              "include": "source.shell"
            }
          ]
        },
        {
          "begin": "^\\s*(`{3,}|~{3,})[ \\t]*(py|python)\\b.*$",
          "end": "^\\s*\\1[ \\t]*$",
          "name": "markup.fenced_code.block.markdown",
          "beginCaptures": {
            "2": {
              "name": "fenced_code.block.language.markdown"
            }
          },
          "contentName": "meta.embedded.block.python source.python",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        },
        {
          "begin": "^\\s*(`{3,}|~{3,})[ \\t]*(yaml|yml)\\b.*$",
          "end": "^\\s*\\1[ \\t]*$",
          "name": "markup.fenced_code.block.markdown",
          "beginCaptures": {
            "2": {
              "name": "fenced_code.block.language.markdown"
            }
          },
          "contentName": "meta.embedded.block.yaml source.yaml",
          "patterns": [
            {
              "include": "source.yaml"
            }
          ]
        },
        {
          "begin": "^\\s*(`{3,}|~{3,})[ \\t]*(nmbl)\\b.*$",
          "end": "^\\s*\\1[ \\t]*$",
          "name": "markup.fenced_code.block.markdown",
          "beginCaptures": {
            "2": {
              "name": "fenced_code.block.language.markdown"
            }
          },
          "contentName": "meta.embedded.block.nmbl source.nmbl",
          "patterns": [
            {
              "include": "source.nmbl"
            }
          ]
        },
        {
          "begin": "^\\s*(`{3,}|~{3,}).*$",
          "end": "^\\s*\\1[ \\t]*$",
          "name": "markup.fenced_code.block.markdown"
        },
        {
          "match": "^\\s*#{1,6}\\s.*$",
          "name": "markup.heading.markdown"
        },
        {
          "match": "^\\s*([-*_])(?:[ \\t]*\\1){2,}[ \\t]*$",
          "name": "meta.separator.markdown"
        },
        {
          "match": "^\\s*>\\s?",
          "name": "markup.quote.markdown"
        },
        {
          "match": "^\\s*([-*+]|\\d+[.)])\\s",
          "name": "punctuation.definition.list.begin.markdown"
        },
        {
          "match": "^\\s*\\|.*\\|[ \\t]*$",
          "name": "markup.table.markdown"
        },
        {
          "begin": "`",
          "end": "`",
          "name": "markup.inline.raw.string.markdown"
        },
        {
          "match": "(!?\\[)([^\\]]*)(\\])(\\()([^)]+)(\\))",
          "captures": {
            "2": {
              "name": "string.other.link.title.markdown"
            },
            "5": {
              "name": "markup.underline.link.markdown"
            }
          }
        },
        {
          "match": "(\\*\\*\\*|___)(?=\\S)(.+?)(?<=\\S)\\1",
          "name": "markup.bold.italic.markdown"
        },
        {
          "match": "(\\*\\*|__)(?=\\S)(.+?)(?<=\\S)\\1",
          "name": "markup.bold.markdown"
        },
        {
          "match": "(\\*|_)(?=\\S)([^*_]+?)(?<=\\S)\\1",
          "name": "markup.italic.markdown"
        },
        {
          "match": "(~~)(?=\\S)(.+?)(?<=\\S)(~~)",
          "name": "markup.strikethrough.markdown"
        }
      ]
    },
    "nmbl-generic-raw-block": {
      "comment": "NMBL generic raw content block (tag: or tag:mode not handled above)",
      "begin": "^(\\s*)([^\\s]*)((:)([A-Za-z][A-Za-z0-9-]*)?)\\s*$",
      "beginCaptures": {
        "2": {
          "patterns": [
            {
              "include": "#componentname"
            },
            {
              "include": "#tagname"
            },
            {
              "include": "#attrname"
            },
            {
              "include": "#punctuation"
            }
          ]
        },
        "3": {
          "name": "storage.type.content-mode.nmbl"
        }
      },
      "while": "^(?=\\1[ \\t]|[ \\t]*$)",
      "name": "string.unquoted.content-block.nmbl"
    }
  }
}
