{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "astro.nmbl",
  "injectionSelector": "source.astro - (meta.embedded | source)",
  "patterns": [
    {
      "begin": "(?<=<template\\s+lang=\"nmbl\"\\s*>)",
      "end": "(?=</template>)",
      "name": "meta.embedded.block.nmbl",
      "contentName": "text.nmbl",
      "patterns": [
        { "include": "text.nmbl" }
      ]
    }
  ]
}
