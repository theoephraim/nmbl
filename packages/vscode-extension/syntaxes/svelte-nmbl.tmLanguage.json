{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "svelte.nmbl",
  "injectionSelector": "L:meta.template.svelte meta.lang.nmbl - (meta source)",
  "patterns": [
    { "include": "#template-content" }
  ],
  "repository": {
    "template-content": {
      "begin": "(?<=>)(?!</)",
      "end": "(?=</)",
      "name": "meta.embedded.block.svelte",
      "contentName": "text.nmbl",
      "patterns": [
        { "include": "text.nmbl" }
      ]
    }
  }
}
