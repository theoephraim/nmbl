{
  "name": "@nmbl/vscode-extension",
  "displayName": "NMBL",
  "version": "0.1.0",
  "private": true,
  "description": "NMBL language support — syntax highlighting for .nmbl, .astro, .svelte, and .vue files",
  "publisher": "nmbl",
  "license": "MIT",
  "scripts": {
    "install-local": "for dir in ~/.vscode/extensions ~/.cursor/extensions ~/.windsurf/extensions; do [ -d \"$dir\" ] && ln -sfn \"$(pwd)\" \"$dir/nmbl.nmbl-0.1.0\" && echo \"Installed to $dir\"; done"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nmbl",
        "aliases": ["NMBL", "nmbl"],
        "extensions": [".nmbl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nmbl",
        "scopeName": "text.nmbl",
        "path": "./syntaxes/nmbl.tmLanguage.json",
        "embeddedLanguages": {
          "source.js": "javascript",
          "source.ts": "typescript",
          "source.md": "markdown",
          "source.css": "css"
        }
      },
      {
        "scopeName": "svelte.nmbl",
        "path": "./syntaxes/svelte-nmbl.tmLanguage.json",
        "injectTo": ["source.svelte"],
        "embeddedLanguages": {
          "text.nmbl": "nmbl"
        }
      },
      {
        "scopeName": "vue.nmbl",
        "path": "./syntaxes/vue-nmbl.tmLanguage.json",
        "injectTo": ["source.vue", "text.html.vue"],
        "embeddedLanguages": {
          "text.nmbl": "nmbl"
        }
      },
      {
        "scopeName": "astro.nmbl",
        "path": "./syntaxes/astro-nmbl.tmLanguage.json",
        "injectTo": ["source.astro"],
        "embeddedLanguages": {
          "text.nmbl": "nmbl"
        }
      }
    ]
  },
  "exports": {
    "./syntaxes/nmbl.tmLanguage.json": "./syntaxes/nmbl.tmLanguage.json"
  }
}
