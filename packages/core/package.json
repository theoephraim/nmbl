{
  "name": "@nmbl-lang/core",
  "version": "0.1.0",
  "description": "Lexer, parser, compiler, formatter, linter, and HTML→NMBL decompiler for the NMBL templating language",
  "keywords": [
    "nmbl",
    "template",
    "templating",
    "compiler",
    "parser",
    "formatter",
    "linter"
  ],
  "license": "MIT",
  "author": "Theo Ephraim",
  "homepage": "https://nmbl.tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theoephraim/nmbl.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "gen": "bun scripts/gen-artifacts.ts",
    "tbuild": "turbo run build",
    "dev": "bun run build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "htmlparser2": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "monogram": "github:johnsoncodehk/monogram#70a801981b897098f0505c5a9e5bcd241a1bd8a4",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
