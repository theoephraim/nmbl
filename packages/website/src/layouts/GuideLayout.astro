---
import BaseLayout from './BaseLayout.astro';
// Shared styles for all framework guide pages. Imported here (not globally) so the
// guide CSS only loads on pages that use this layout — keeps it out of the index,
// about, etc., which carry their own scoped styles.
import '../styles/guides.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<BaseLayout title={title}>
  <slot />
</BaseLayout>

<script>
  // Scroll-spy: highlight the TOC link for the section currently under the
  // sticky header. Sticky h2 siblings PILE at top:0 (all report the same
  // rendered position), so we compare scroll position against each heading's
  // NATURAL document offset (offsetTop chain, which sticky doesn't change).
  const links = new Map(
    [...document.querySelectorAll('.toc a[href^="#"]')].map((a) => [
      decodeURIComponent((a as HTMLAnchorElement).hash.slice(1)),
      a,
    ]),
  );
  // Only track headings that have a TOC entry, so an unlinked subsection keeps
  // its parent section highlighted instead of clearing the highlight.
  const headings = [...document.querySelectorAll('.prose :is(h2, h3)[id]')].filter((h) =>
    links.has(h.id),
  );

  if (headings.length && links.size) {
    const rootStyle = getComputedStyle(document.documentElement);
    const rem = parseFloat(rootStyle.fontSize);
    // The site header is sticky, so the first content visible below it starts at
    // --header-h; the activation line sits just under that.
    const headerH = parseFloat(rootStyle.getPropertyValue('--header-h')) * rem || 0;
    let tops: { id: string; y: number }[] = [];
    let active: string | null = null;

    const measure = () => {
      tops = headings.map((h) => {
        let y = 0;
        let el: HTMLElement | null = h as HTMLElement;
        while (el) {
          y += el.offsetTop;
          el = el.offsetParent as HTMLElement | null;
        }
        return { id: h.id, y };
      });
    };

    const update = () => {
      const pos = window.scrollY + headerH + rem; // activation line just below the header
      let current = tops[0].id;
      for (const t of tops) {
        if (t.y <= pos) current = t.id;
        else break;
      }
      if (current === active) return;
      active = current;
      links.forEach((l) => l.classList.remove('active'));
      links.get(active)?.classList.add('active');
    };

    // Smooth-scroll TOC clicks ourselves. Native anchor scrolling misfires when
    // the target heading is `position: sticky` above the current scroll position
    // (it updates the hash but doesn't move). We can't measure the target at
    // click time either: for a stuck sticky element both offsetTop AND
    // getBoundingClientRect report the stuck position, not its natural one. So
    // use the natural offsets already captured in `tops` (measured at load /
    // resize, when nothing is stuck), minus the heading's CSS `top`.
    links.forEach((a, id) => {
      a.addEventListener('click', (e) => {
        const target = document.getElementById(id);
        const entry = tops.find((t) => t.id === id);
        if (!target || !entry) return;
        e.preventDefault();
        const stuckTop = parseFloat(getComputedStyle(target).top) || 0;
        window.scrollTo({ top: Math.max(0, entry.y - stuckTop - rem * 0.5), behavior: 'smooth' });
        history.pushState(null, '', `#${id}`);
      });
    });

    let ticking = false;
    addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      },
      { passive: true },
    );
    addEventListener('resize', () => {
      measure();
      update();
    });
    addEventListener('load', () => {
      measure();
      update();
    });
    measure();
    update();
  }
</script>
