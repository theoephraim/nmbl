---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Code } from 'astro-expressive-code/components';
import FrameworkShowcase from '../components/FrameworkShowcase.astro';
import CodeToggle from '../components/CodeToggle.astro';
import { EDITOR_PAGE } from '../links';
import {
  SHOWCASE_BASICS, SHOWCASE_COMMENTS, SHOWCASE_MARKDOWN,
  SHOWCASE_PROMPT, SHOWCASE_PROMPT_OUTPUT,
} from '../examples';
---

<template lang="nmbl">
BaseLayout(title="Home")
  section.hero
    .container
      h1
        <svg class="hero-mark" width="64" height="64" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="2" y="3" width="2.6" height="18" rx="1.3" fill="var(--rainbow-0)"/>
        <rect x="6.35" y="5.5" width="2.6" height="15.5" rx="1.3" fill="var(--rainbow-1)"/>
        <rect x="10.7" y="8" width="2.6" height="13" rx="1.3" fill="var(--rainbow-2)"/>
        <rect x="15.05" y="10.5" width="2.6" height="10.5" rx="1.3" fill="var(--rainbow-3)"/>
        <rect x="19.4" y="13" width="2.6" height="8" rx="1.3" fill="var(--rainbow-4)"/>
        </svg>
        span.hero-word nmbl
      p.acronym <strong>N</strong>o <strong>M</strong>ore <strong>B</strong>rackets <strong>L</strong>anguage
      p.tagline Write HTML without the noise.
      p.tagline-sub An indentation-based shorthand that compiles to clean HTML for Vue, Svelte, Astro, React &amp; Solid &mdash; fewer tags, fewer tokens for you and your AI.
      .hero-actions
        a.btn.btn-primary(href="/get-started") Get Started
        a.btn.btn-secondary(href="/playground") Try the Playground
        a.btn.btn-ghost(href="https://github.com/theoephraim/nmbl" target="_blank" rel="noopener") GitHub

  section.showcase
    .container
      .feature-row
        CodeToggle(nmbl={SHOWCASE_BASICS})
        .feature-text:md
          ### You already know nmbl

          
          It's shorthand HTML, not a new language - the basics take 5 minutes to learn. Indentation is the structure - no closing tags to keep in sync.
          
          

      .feature-row
        CodeToggle(nmbl={SHOWCASE_COMMENTS})
        .feature-text:md
          ### Comments that actually work

          No more leaving dev comments in output or awkward `{/* ... */}`. nmbl lets you control whether comments are stripped or preserved, and even comment out attributes without breaking your layout.

      .feature-row
        CodeToggle(nmbl={SHOWCASE_MARKDOWN})
        .feature-text:md
          ### Markdown, right inline

          Append `:md` to any element and its body becomes markdown, rendered at
          build time. Prose-heavy sections stay readable instead of drowning in
          `<p>` and `<h2>` tags — and it works in every integration.

  section.benefits
    .container
      .benefits-grid
        .benefit
          h3 Less to type, fewer tokens
          p A typical template runs 30&ndash;40% shorter than the equivalent HTML &mdash; no closing tags, no bracket soup. Fewer keystrokes for you, and fewer tokens for the LLMs reading and writing your markup.
        .benefit
          h3 Fits your stack, zero runtime
          p <code>&lt;template lang="nmbl"&gt;</code> in Vue and Svelte, an Astro integration, and <code>nmbl`…`</code> tagged templates in React, Solid &amp; Qwik &mdash; all compiled to standard HTML at build time, with nothing shipped to the browser.
        .benefit
          h3 Real editor support
          p IntelliSense in Vue SFCs via a Volar plugin &mdash; hover, go-to-definition, error squiggles. Highlighting everywhere, generated from a single grammar definition so it can never drift from what the parser accepts.
          a.benefit-link(href={EDITOR_PAGE}) Editor support →
        .benefit
          h3 Bidirectional
          p Convert HTML to nmbl and back. The decompiler produces clean, idiomatic output from any HTML input &mdash; drop in an existing page and start editing immediately.

  FrameworkShowcase

  section.prompt-showcase
    .container
      h2 Not just markup — structured prompts too
      p.section-subtitle When a prompt needs real structure &mdash; roles, tasks, nested context &mdash; the same notation compiles to clean, XML-tagged prompts. Your markdown stays markdown (with editor highlighting), and the same file can be parsed into a structured object for validation and transformation.
      .prompt-grid
        .prompt-col
          .prompt-label nmbl
          .showcase-code
            Code(code={SHOWCASE_PROMPT} lang="nmbl" frame="none")
        .prompt-arrow
          span →
        .prompt-col
          .prompt-label Compiled prompt
          .showcase-code
            Code(code={SHOWCASE_PROMPT_OUTPUT} lang="html" frame="none" copyable={false})
      a.prompt-link(href="/guides/prompts") Prompts &amp; structured-data guide →

  section.playground-cta
    .container
      h2 See it all together
      p.section-subtitle A full, runnable example &mdash; switch frameworks and watch nmbl compile to each one&rsquo;s native output, live.
      a.btn.btn-primary(href="/playground") Open the Playground
</template>

<style>
  .hero {
    padding: 6rem 0 4rem;
    text-align: center;
  }

  .hero h1 {
    font-size: 4rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--color-accent);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .hero-mark {
    width: 4rem;
    height: 4rem;
    flex-shrink: 0;
  }

  .acronym {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    margin-bottom: 1.25rem;
  }

  .acronym strong {
    color: var(--color-accent);
    font-weight: 600;
  }

  .tagline {
    font-size: 1.35rem;
    color: var(--color-text);
    max-width: 640px;
    margin: 0 auto 0.75rem;
  }

  .tagline-sub {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    max-width: 640px;
    margin: 0 auto 2.5rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 500;
    transition: all 0.2s;
  }

  .btn-primary {
    background: var(--color-accent);
    color: white;
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    color: white;
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .btn-ghost {
    background: transparent;
    color: var(--color-text-muted);
  }

  .btn-ghost:hover {
    color: var(--color-text);
  }

  .showcase {
    padding: 4rem 0;
  }

  .feature-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .feature-row + .feature-row {
    margin-top: 2.5rem;
  }

  .feature-text {
    display: flex;
    flex-direction: column;
    gap: .25em;
  }

  .feature-text h3 {
    font-size: 1.25rem;
  }

  .feature-text p {
    color: var(--color-text-muted);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .feature-text code {
    background: rgba(var(--color-accent-rgb), 0.15);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.875rem;
    color: var(--color-accent);
  }

  .showcase-code {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    --ecIndent: 0;
  }

  .showcase-code :global(.expressive-code) {
    margin: 0;
  }

  .showcase-code :global(.expressive-code figure) {
    margin: 0;
    border: none;
    border-radius: 0;
  }
  .showcase-code :global(.copy) {
    display: none !important;
  }

  /* expressive-code splits padding between <pre> (inline) and the inner <code>
     (block) and sets it with high specificity — force both to sit tight. */
  .showcase-code :global(.expressive-code pre) {
    padding: 0.4rem 0.8rem !important;
    font-size: 0.8125rem;
    line-height: 1.5;
    border: none;
    border-radius: 0;
  }

  .showcase-code :global(.expressive-code pre > code) {
    padding: 0 !important;
  }

  .benefits {
    padding: 3rem 0 4rem;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .benefit {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.5rem;
  }

  .benefit h3 {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
  }

  .benefit p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .benefit code {
    background: rgba(var(--color-accent-rgb), 0.15);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.8125rem;
    color: var(--color-accent);
  }

  .benefit-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
  }

  .benefit-link:hover {
    color: var(--color-accent-hover);
  }

  .playground-cta {
    padding: 4rem 0;
    text-align: center;
  }

  .playground-cta h2 {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .section-subtitle {
    color: var(--color-text-muted);
    max-width: 640px;
    margin: 0 auto 2rem;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .prompt-showcase {
    padding: 4rem 0;
  }

  .prompt-showcase h2 {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .prompt-showcase .section-subtitle code {
    background: rgba(var(--color-accent-rgb), 0.15);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.85em;
    color: var(--color-accent);
  }

  .prompt-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .prompt-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .prompt-arrow {
    color: var(--color-accent);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
  }

  .prompt-link {
    display: block;
    text-align: center;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-accent);
  }

  .prompt-link:hover {
    color: var(--color-accent-hover);
  }

  @media (max-width: 768px) {
    .hero h1 {
      font-size: 2.5rem;
    }

    .benefits-grid,
    .feature-row {
      grid-template-columns: 1fr;
    }

    /* Prompt before→after: stack vertically, point the arrow down. */
    .prompt-grid {
      grid-template-columns: 1fr;
    }

    .prompt-arrow {
      transform: rotate(90deg);
      justify-self: center;
      padding: 0.25rem 0;
    }

    /* Stacked: wrap the snippet and its text in one connected card. The common
       border + radius lives on the row; the code block drops its own border and
       rounding so it joins flush to the text below (divider between them). */
    .feature-row {
      gap: 0;
      border: 1px solid var(--color-border);
      border-radius: 8px;
      overflow: hidden;
    }

    .showcase-code {
      border: none;
      border-radius: 0;
      border-bottom: 1px solid var(--color-border);
    }

    .feature-text {
      padding: 1rem;
    }
  }
</style>
