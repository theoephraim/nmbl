---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Code } from 'astro-expressive-code/components';
import {
  HOMEPAGE_EXAMPLE_NMBL, HOMEPAGE_EXAMPLE_HTML,
  FEATURE_EMBEDDED_MD,
  COMMENT_VISIBILITY, COMMENT_VISIBILITY_HTML,
  COMMENT_ATTR, COMMENT_ATTR_HTML,
} from '../examples';
---

<template lang="nmbl">
BaseLayout(title="Home")
  section.hero
    .container
      h1
        span.hero-mark &gt;&lt;
        |  NMBL
      p.acronym <strong>N</strong>o <strong>M</strong>ore <strong>B</strong>rackets <strong>L</strong>anguage
      p.tagline A shorthand notation for HTML<br/>built for modern web frameworks and token efficiency.
      p.tagline-sub Closing tags, angle brackets, id/class attributes &mdash; NMBL strips the noise so you and your AI can <b>do more with less</b>.
      .hero-actions
        a.btn.btn-primary(href="/playground") Try the Playground

  section.benefits
    .container
      .benefits-grid
        .benefit
          h3 Easier to read
          p Indentation shows structure. No closing tags or brackets to scan past. You see the content and hierarchy immediately.
        .benefit
          h3 Faster to write
          p CSS selector shorthand for ids and classes. Implicit <code>div</code> tags. No closing tags to keep in sync. A typical template is 30&ndash;40% shorter than equivalent HTML.
        .benefit
          h3 Increased token efficiency
          p Every <code>&lt;/div&gt;</code> and <code>class=</code> burns tokens unnecessarily. NMBL lets LLMs read and write markup with fewer tokens &mdash; saving context window and generation time.
        .benefit
          h3 Fits your stack
          p Use <code>&lt;template lang="nmbl"&gt;</code> in Vue SFCs. Drop in the Vite plugin. Add the Astro integration. Use <code>nmbl`…`</code> tagged templates in React, Solid, and Qwik &mdash; compiled away at build time, zero runtime. NMBL compiles to standard HTML that any framework already understands.
        .benefit
          h3 (Almost) Nothing to learn
          p NMBL is not a new language &mdash; it's a shorthand that maps directly to HTML. Give it 10 minutes and it will click.
        .benefit
          h3 Real editor support
          p Full IntelliSense in Vue SFCs via a Volar plugin &mdash; hover, go-to-definition, error squiggles, refactoring. Source maps for Svelte. Syntax highlighting everywhere.

  section.comparison
    .container
      h2 Same structure. Less noise.
      .comparison-grid
        .comparison-pane
          div.comparison-label:
            NMBL &mdash; {HOMEPAGE_EXAMPLE_NMBL.split('\n').length} lines, {HOMEPAGE_EXAMPLE_NMBL.length} chars
          Code(code={HOMEPAGE_EXAMPLE_NMBL} lang="nmbl" frame="none")
        .comparison-pane
          div.comparison-label:
            HTML &mdash; {HOMEPAGE_EXAMPLE_HTML.split('\n').length} lines, {HOMEPAGE_EXAMPLE_HTML.length} chars
          Code(code={HOMEPAGE_EXAMPLE_HTML} lang="html" frame="none")

  section.comments-section
    .container
      h2 Comments that actually work.
      p.section-subtitle HTML has no way to comment out an attribute. Most template languages inherit that limitation. NMBL treats comments as a first-class feature &mdash; with control over what reaches production.

      .comments-grid
        .comment-card
          h3 You control what ships
          p:
            Use <code>//</code> for developer notes that are <strong>stripped from output</strong> &mdash; TODOs, debug notes, nothing ships to production. Use <code>//!</code> when you <strong>explicitly want</strong> an HTML comment in the output.
          .comment-compare
            .comment-pane
              .comment-pane-label NMBL
              Code(code={COMMENT_VISIBILITY} lang="nmbl" frame="none")
            .comment-pane
              .comment-pane-label HTML output
              Code(code={COMMENT_VISIBILITY_HTML} lang="html" frame="none")

        .comment-card
          h3 Comments inside attributes
          p:
            Something HTML and every other template language lack: comment out individual attributes while debugging. Use <code>//</code> for single-line or <code>/* */</code> for inline &mdash; toggle attributes without deleting them.
          .comment-compare
            .comment-pane
              .comment-pane-label NMBL
              Code(code={COMMENT_ATTR} lang="nmbl" frame="none")
            .comment-pane
              .comment-pane-label HTML output
              Code(code={COMMENT_ATTR_HTML} lang="html" frame="none")

  section.features
    .container
      h2 Features
      .features-grid
        .feature
          h3 CSS-like selectors
          p Use <code>#id</code> and <code>.class</code> shorthand directly on elements. Implicit <code>div</code> when using selectors alone.
        .feature
          h3 Block expansion
          p Nest single children inline with <code>&gt;</code> syntax. Perfect for navigation lists: <code>li &gt; a(href="/") Home</code>
        .feature
          h3 Embedded content blocks
          p A trailing <code>:</code> switches to raw content mode &mdash; <code>script:</code> and <code>style:</code> blocks pass nested content through untouched. Name a mode like <code>article:md</code> and register a filter through the compiler API to transform it at build time.
          .feature-code
            Code(code={FEATURE_EMBEDDED_MD} lang="nmbl" frame="none")
        .feature
          h3 Bidirectional
          p Convert HTML to NMBL and back. The decompiler produces clean, idiomatic NMBL from any HTML input. Drop in existing HTML and start editing in NMBL immediately.
        .feature
          h3 One grammar, every editor
          p The parser, TextMate grammar, tree-sitter grammar, and VS Code language configuration are all generated from a single grammar definition (via <a href="https://github.com/johnsoncodehk/monogram" target="_blank">monogram</a>). Syntax highlighting can never drift from what the parser actually accepts.
</template>

<style>
  .hero {
    padding: 6rem 0 4rem;
    text-align: center;
  }

  .hero h1 {
    font-size: 4rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .hero-mark {
    letter-spacing: -0.05em;
  }

  .acronym {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    margin-bottom: 1.25rem;
  }

  .acronym strong {
    color: var(--color-accent);
    font-weight: 600;
  }

  .tagline {
    font-size: 1.35rem;
    color: var(--color-text);
    max-width: 640px;
    margin: 0 auto 0.75rem;
  }

  .tagline-sub {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    max-width: 640px;
    margin: 0 auto 2.5rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 500;
    transition: all 0.2s;
  }

  .btn-primary {
    background: var(--color-accent);
    color: white;
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    color: white;
  }

  .benefits {
    padding: 3rem 0 4rem;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .benefit {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.5rem;
  }

  .benefit h3 {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
  }

  .benefit p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .benefit code {
    background: rgba(124, 110, 246, 0.15);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.8125rem;
    color: var(--color-accent);
  }

  .comparison {
    padding: 4rem 0;
  }

  .comparison h2 {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 2rem;
  }

  .comparison-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
  }

  .comparison-pane {
    background: var(--color-surface);
  }

  .comparison-label {
    padding: 0.5rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .comparison-pane :global(.expressive-code) {
    margin: 0;
  }

  .comparison-pane :global(.expressive-code figure) {
    margin: 0;
    border: none;
    border-radius: 0;
  }

  .comparison-pane :global(.expressive-code pre) {
    padding: 1.5rem;
    font-size: 0.875rem;
    line-height: 1.7;
    overflow-x: auto;
    border: none;
    border-radius: 0;
  }

  .comments-section {
    padding: 4rem 0;
  }

  .comments-section h2 {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-text-muted);
    max-width: 640px;
    margin: 0 auto 2rem;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .comments-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .comment-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.5rem;
  }

  .comment-card h3 {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
  }

  .comment-card p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .comment-card code {
    background: rgba(124, 110, 246, 0.15);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.8125rem;
    color: var(--color-accent);
  }

  .comment-compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    overflow: hidden;
  }

  .comment-pane {
    background: var(--color-surface);
  }

  .comment-pane-label {
    padding: 0.375rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .comment-pane :global(.expressive-code) {
    margin: 0;
  }

  .comment-pane :global(.expressive-code figure) {
    margin: 0;
    border: none;
    border-radius: 0;
  }

  .comment-pane :global(.expressive-code pre) {
    padding: 0.75rem 1rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    border: none;
    border-radius: 0;
  }

  .features {
    padding: 4rem 0;
  }

  .features h2 {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 2rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .feature {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.5rem;
  }

  .feature h3 {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
  }

  .feature p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .feature code {
    background: rgba(124, 110, 246, 0.15);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.8125rem;
    color: var(--color-accent);
  }

  .feature-code {
    margin-top: 0.75rem;
    overflow-x: auto;
  }

  .feature-code :global(.expressive-code) {
    margin: 0;
  }

  .feature-code :global(.expressive-code figure) {
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: 6px;
  }

  .feature-code :global(.expressive-code pre) {
    padding: 0.75rem 1rem;
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .hero h1 {
      font-size: 2.5rem;
    }

    .benefits-grid,
    .comparison-grid,
    .features-grid,
    .comments-grid {
      grid-template-columns: 1fr;
    }

    .comment-compare {
      grid-template-columns: 1fr;
    }
  }
</style>
