    font-weight: 600;
  }

  .backstory {
    padding: 3rem 0;
  }

  .backstory h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    text-align: center;
  }

  .prose {
    max-width: 720px;
    margin: 0 auto;
  }

  .prose h3 {
    font-size: 1.25rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
  }

  .prose p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.8;
  }

  .prose p + p {
    margin-top: 0.75rem;
  }

  .prose em {
    color: var(--color-text);
    font-style: italic;
  }

  .prose code {
    background: rgba(124, 110, 246, 0.15);
