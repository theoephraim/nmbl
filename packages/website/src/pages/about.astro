    color: var(--color-text-muted);
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .lead strong {
    color: var(--color-accent);
    font-weight: 600;
  }

  .backstory {
    padding: 3rem 0;
  }

  .backstory h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    text-align: center;
  }

  .prose {
    max-width: 720px;
    margin: 0 auto;
  }

  .prose h3 {
    font-size: 1.25rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
  }

  .prose p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.8;
  }

  .prose p + p {
    margin-top: 0.75rem;
  }

  .prose em {
    color: var(--color-text);
    font-style: italic;
  }

  .prose code {
    background: rgba(var(--color-accent-rgb), 0.15);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.8125rem;
    color: var(--color-accent);
  }

  .principles {
    padding: 4rem 0;
  }

  .principles h2 {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 2rem;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .principle {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.5rem;
  }

  .principle h3 {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
  }

  .principle p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .principle code {
    background: rgba(var(--color-accent-rgb), 0.15);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.8125rem;
    color: var(--color-accent);
  }

  .principle em {
    color: var(--color-text);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .about-hero h1 {
      font-size: 2rem;
    }

    .principles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
