  .about-hero {
    padding: 4rem 0 2rem;
    text-align: center;
  }

  .about-hero h1 {
    font-size: 2.5rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .lead {
