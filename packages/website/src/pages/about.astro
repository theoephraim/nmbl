  }

  .principles {
    padding: 4rem 0;
  }

  .principles h2 {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 2rem;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .principle {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.5rem;
  }

  .principle h3 {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
  }

  .principle p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .principle code {
    background: rgba(124, 110, 246, 0.15);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.8125rem;
    color: var(--color-accent);
  }

  .principle em {
    color: var(--color-text);
    font-style: italic;
  }

