{
  "name": "@nmbl/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "nmbl": "./dist/cli.mjs"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "tbuild": "turbo run build",
    "dev": "bun run build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nmbl/parser": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
