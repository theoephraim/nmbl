{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // tsserver plugins are CommonJS, and `export =` requires a CJS module target.
    // node16 resolves this package (no "type" field) as CommonJS.
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
