{
  "name": "nmbl",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo run build --filter=!@nmbl/website --filter=!example/*",
    "build:all": "turbo run build",
    "build:libs": "turbo run build --filter=!@nmbl/website --filter=!example/*",
    "build:examples": "turbo run build --filter=example/*",
    "test": "turbo run test",
    "dev": "turbo run dev"
  },
  "packageManager": "bun@1.3.4",
  "devDependencies": {
    "turbo": "^2.8.10"
  },
  "catalog": {
    "astro": "^5.0.0",
    "htmlparser2": "^9.1.0",
    "svelte": "^5.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "vue": "^3.5.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/compiler-dom": "^3.5.0",
    "tsdown": "^0.20.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
