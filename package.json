{
  "name": "nmbl",
  "private": true,
  "license": "MIT",
  "author": "Theo Ephraim",
  "homepage": "https://nmbl.tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theoephraim/nmbl.git"
  },
  "scripts": {
    "build": "turbo run build --filter=!@nmbl-lang/website --filter=!example/*",
    "build:all": "turbo run build",
    "build:libs": "turbo run build --filter=!@nmbl-lang/website --filter=!example/*",
    "build:examples": "turbo run build --filter=example/*",
    "test": "turbo run test",
    "dev": "turbo run dev"
  },
  "devDependencies": {
    "@socketsecurity/bun-security-scanner": "^1.1.2",
    "@varlock/bumpy": "^1.13.2",
    "turbo": "^2.9.18"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "packageManager": "bun@1.3.14",
  "fledgling": {
    "provider": "github",
    "workflow": "release.yml",
    "environment": "publish",
    "permissions": "publish"
  },
  "catalog": {
    "astro": "^6.4.6",
    "htmlparser2": "^12.0.0",
    "marked": "^18.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "solid-js": "^1.9.0",
    "vite-plugin-solid": "^2.11.0",
    "svelte": "^5.56.3",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "vue": "^3.5.38",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-dom": "^3.5.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.8",
    "yaml": "^2.6.0"
  }
}
