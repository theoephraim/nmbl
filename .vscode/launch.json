{
  "version": "0.2.0",
  "configurations": [
    {
      // this launches the vscode plugin debug environment
      // TODO: ideally this would live within the vscode extension folder?
      "name": "Launch Extension: NMBL language",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-extension",
        "--disable-extensions",
        "${workspaceFolder}/packages/vscode-extension",
      ],
      "outFiles": ["${workspaceFolder}/packages/vscode-extension/**/*.js"]
    },
  ],
}
